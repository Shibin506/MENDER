# GitHub App
MENDER_GITHUB_APP_ID=123456
MENDER_GITHUB_PRIVATE_KEY_PATH=./mender.private-key.pem
MENDER_GITHUB_WEBHOOK_SECRET=change-me

# Model backend: claude (default) or gemini
MENDER_PROVIDER=claude

# Claude
ANTHROPIC_API_KEY=
MENDER_MODEL=claude-opus-5-5
MENDER_EFFORT=medium

# Gemini (free tier works; sent as a bearer token to the OpenAI-compatible endpoint)
MENDER_GEMINI_API_KEY=
MENDER_GEMINI_MODEL=gemini-3.5-flash

# Storage
MENDER_DATABASE_URL=postgresql+psycopg://mender:mender@localhost:5432/mender

# Set to true to log comments instead of posting them
MENDER_DRY_RUN=false
